# Somente servidor. Nunca adicione o prefixo VITE_ a segredos.
# Use a conexão PostgreSQL do projeto Portfoliov5 já existente no Neon.
DATABASE_URL=postgresql://usuario:senha@host-pooler.neon.tech/neondb?sslmode=require
SESSION_SECRET=substitua-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Deixe vazios se o administrador já existe no seu banco.
# O bootstrap só cria contas novas; não altera senhas existentes.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Opcional: IA para criar imagens de projetos a partir de repositórios públicos.
# Configure no servidor ou Vercel. Nunca use prefixo VITE_.
AI_GATEWAY_API_KEY=
AI_PREVIEW_MODEL=google/gemini-3.1-flash-image

# Opcional: token GitHub com acesso apenas de leitura para ampliar o limite de consultas.
# Repositórios privados continuam bloqueados nesta função.
GITHUB_TOKEN=
