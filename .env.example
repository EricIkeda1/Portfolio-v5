# Nunca use VITE_ nestas variáveis: elas são somente do backend.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Opcionais: servem apenas para criar um admin em um banco novo.
# Depois que o usuário existir no Neon, podem ser removidas da Vercel.
ADMIN_EMAIL=seu-email@dominio.com
ADMIN_PASSWORD_HASH=scrypt$...
